# Copy to .env (git-ignored). Docker Compose also reads this file.
PAYNEST_REGION=demo
DATABASE_URL=postgresql://paynest:paynest@localhost:5433/paynest

# Upstash Redis (used locally and in production). From the Upstash console:
# rediss://default:<token>@<your-db>.upstash.io:6379
REDIS_URL=

# Amazon SQS in Sydney. Create the dev queues once: python scripts/create_dev_queues.py
SQS_QUEUE_NAME=paynest-dev-tickets-in

# AWS profile signed in with: aws login --profile payce-fde --remote
AWS_PROFILE=payce-fde

# Models (phase 6 onwards). Bedrock replaces OpenRouter once AWS lifts the hold.
OPENROUTER_API_KEY=
