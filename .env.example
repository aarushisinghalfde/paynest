# Copy to .env (git-ignored). Docker Compose also reads this file.
PAYNEST_REGION=demo
DATABASE_URL=postgresql://paynest:paynest@localhost:5433/paynest

# Upstash Redis (used locally and in production). From the Upstash console:
# rediss://default:<token>@<your-db>.upstash.io:6379
REDIS_URL=

# Amazon SQS in Sydney. Create the dev queues once: python scripts/create_dev_queues.py
SQS_QUEUE_NAME=paynest-dev-tickets-in
# Optional, offline: use the local ElasticMQ stand-in instead of real SQS.
# Set to http://localhost:9324 and start with: docker compose --profile local-queue up -d
# Leave empty for real SQS.
SQS_ENDPOINT_URL=

# Phase 3 PII gate. HMAC key for sender email/phone tokens: generate once with
#   python -c "import secrets; print('PII_HMAC_KEY=' + secrets.token_hex(32))" | Add-Content .env
# then copy it to SSM with .\scripts\put_secrets.ps1. Never reuse it across environments.
PII_HMAC_KEY=
# Where raw values go: memory (laptop only) or dynamo (AWS).
VAULT_BACKEND=memory
# auto | required | off. The AWS worker uses required.
PII_NER=auto

# AWS profile signed in with: aws login --profile payce-fde --remote
AWS_PROFILE=payce-fde

# Models (phase 6 onwards). Bedrock replaces OpenRouter once AWS lifts the hold.
OPENROUTER_API_KEY=
