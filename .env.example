# Copy to .env (git-ignored) for running scripts and tests on the laptop.
# Docker Compose sets its own values for the containers.
PAYNEST_REGION=demo
DATABASE_URL=postgresql://paynest:paynest@localhost:5433/paynest
VALKEY_URL=redis://localhost:6380/0
SQS_ENDPOINT_URL=http://localhost:9324
SQS_QUEUE_NAME=tickets-in

# Models (phase 6 onwards). Bedrock replaces OpenRouter once AWS lifts the hold.
OPENROUTER_API_KEY=

# AWS (phase 2 onwards): the Agentic Core FDE profile, Sydney
AWS_PROFILE=payce-fde
